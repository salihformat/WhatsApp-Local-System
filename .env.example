# ==========================================
# إعدادات التطبيق الأساسية
# ==========================================
APP_NAME="WhatsApp Local System Rasayily" # اسم التطبيق الافتراضي
LOCAL_SYSTEM_VERSION="1.0.0" # إصدار النظام الحالي
APP_ENV=local # بيئة العمل الحالية (local للتطوير أو production للإنتاج)
APP_KEY=base64:rLkagUMVWJ0ZaZbqIdfQiE9g3LSKFl7kk= # مفتاح التشفير (يجب أن يكون فريداً لكل مشروع، يتم إنشاؤه عبر php artisan key:generate)
APP_DEBUG=false # تفعيل وضع تصحيح الأخطاء (يجب أن يكون false في الإنتاج لحماية البيانات)
LOG_LEVEL=debug # مستوى تسجيل الأخطاء في السجلات (Logs)
APP_URL=http://localhost:8006 # الرابط الأساسي للوصول للنظام المحلي

# ==========================================
# إعدادات قاعدة البيانات (Database)
# ==========================================
DB_CONNECTION=mysql # نوع قاعدة البيانات المستخدمة
DB_HOST=127.0.0.1 # خادم قاعدة البيانات (المحلي)
DB_PORT=3306 # منفذ الاتصال بقاعدة البيانات
DB_DATABASE=whatsapp_local # اسم قاعدة بيانات النظام المحلي
DB_USERNAME=root # اسم المستخدم لقاعدة البيانات
DB_PASSWORD= # كلمة مرور قاعدة البيانات المحلية (اتركها فارغة إذا لم تكن هناك كلمة مرور)

# ==========================================
# إعدادات الاتصال بالنظام المركزي (البنية التحتية فقط)
# ==========================================
CENTRAL_API_URL="https://rasayily.com/api" # رابط الـ API الخاص بالنظام المركزي للتواصل معه
CENTRAL_API_TIMEOUT=60 # أقصى مدة بالثواني للانتظار قبل اعتبار الاتصال بالنظام المركزي فاشلاً

# ==========================================
# إعدادات المراقبة التلقائية للمجلدات (مسارات النظام فقط)
# ==========================================
MONITORING_FOLDER_PATH="C:/PrintMonitor" # مسار المجلد الذي يتم مراقبته لإرسال أي ملفات توضع فيه تلقائياً
MONITORING_INTERVAL_SECONDS=10 # عدد الثواني التي تفصل بين كل عملية فحص للمجلد

# ==========================================
# إعدادات النظام الداخلية
# ==========================================
SESSION_DRIVER=database # طريقة حفظ الجلسات (Sessions)، الافتراضي قاعدة البيانات
QUEUE_CONNECTION=database # طريقة معالجة المهام الخلفية (Queues)
DB_QUEUE_RETRY_AFTER=220 # مهلة إعادة المحاولة للمهام في قاعدة البيانات لمنع التكرار (بالثواني)
CACHE_STORE=database # محرك التخزين المؤقت (Cache)
APP_LOCALE=ar # لغة واجهة النظام الافتراضية (العربية)
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# ==========================================
# إعدادات الأمان والتشفير (للنظام المحلي)
# ==========================================
API_ENCRYPTION_KEY="" # مفتاح التشفير الخاص بالتواصل (اختياري)
API_VERIFY_SSL=false # التحقق من شهادة الـ SSL للاتصالات الخارجية (اجعلها false في بيئة التطوير)
API_USER_AGENT="WhatsApp-Local-System/1.0" # اسم المتصفح الافتراضي للطلبات الصادرة

# ==========================================
# مسارات البرامج التنفيذية (تعتمد على نظام التشغيل)
# ==========================================
SUMATRA_PDF_PATH="C:/SumatraPDF/SumatraPDF.exe" # مسار برنامج SumatraPDF المستخدم لطباعة الملفات بصمت
PRINT_TIMEOUT_SECONDS=180 # أقصى مدة بالثواني للانتظار حتى تنتهي الطباعة
LIBREOFFICE_PATH="C:/Program Files/LibreOffice/program/soffice.exe" # مسار LibreOffice لتحويل ملفات الأوفيس إلى PDF
OFFICE_CONVERSION_TIMEOUT_SECONDS=120 # أقصى مدة بالثواني لانتظار تحويل ملف أوفيس إلى PDF

# ==========================================
# قراءة النصوص من الصور (OCR) — مسارات البرامج فقط (اختياري)
# ==========================================
TESSERACT_BIN_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe" # مسار برنامج Tesseract OCR بعد تثبيته (راجع صفحة /docs للتفاصيل)
GHOSTSCRIPT_BIN_PATH="C:/Program Files/gs/gs10.07.1/bin/gswin64c.exe" # مسار Ghostscript — يُستخدم لتحويل صفحة PDF الأولى لصورة كاحتياطي OCR

# ==========================================
# مسار النسخ الاحتياطي (مسار نظام التشغيل فقط)
# ==========================================
MYSQLDUMP_PATH="C:/xampp/mysql/bin/mysqldump.exe" # مسار mysqldump.exe المستخدم للنسخ الاحتياطي اليومي التلقائي

# ==========================================
# ملاحظة: الإعدادات التشغيلية التالية تُدار الآن من صفحة /settings
# (محفوظة في جدول settings بقاعدة البيانات):
# LOCAL_SYSTEM_NAME, DEVICE_NAME, LOCATION, PLAN_TYPE,
# CENTRAL_API_COMPANY_ID, CENTRAL_API_TOKEN, CENTRAL_API_RETRY_ATTEMPTS, CENTRAL_API_RETRY_DELAY,
# FILE_STORAGE_PATH, FILE_MAX_SIZE_MB, FILE_ALLOWED_TYPES, FILE_AUTO_DELETE_DAYS,
# MAX_RETRY_ATTEMPTS, RETRY_DELAY_MINUTES, MONITORING_MESSAGE_TEXT,
# PRINTER_ALERT_PHONE, PRINTING_ENABLED, PRINTABLE_EXTENSIONS, PRINT_IMAGE_PAGE_SIZE,
# PRINT_IMAGE_DPI, PRINTING_APPROVAL_REMINDER_*, PRINTING_REPLY_*, PRINTING_NOTIFY_*,
# PHONE_EXTRACTION_*, FILE_NUMBER_LABELS, PHONE_MATCH_MODE, ENABLE_UNLABELED_PHONE_FALLBACK,
# PHONE_REVIEW_REQUIRED_SOURCES, MONITOR_FOLDER_REQUIRE_APPROVAL,
# HEALTH_ALERT_*, BACKUP_RETENTION_DAYS, CONVERSATION_DISTRIBUTION_*
# ==========================================
