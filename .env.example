# ==========================================
# إعدادات التطبيق الأساسية
# ==========================================
APP_NAME="WhatsApp Local System Rasayily" # اسم التطبيق الافتراضي
LOCAL_SYSTEM_NAME="نظام الفواتير المحلي" # الاسم المميز لهذا النظام المحلي (مثال: فرع الرياض)
LOCAL_SYSTEM_VERSION="1.0.0" # إصدار النظام الحالي
APP_ENV=local # بيئة العمل الحالية (local للتطوير أو production للإنتاج)
APP_KEY=base64:rLkagUMVWJ0ZaZbqIdfQiE9g3LSKFl7kk= # مفتاح التشفير (يجب أن يكون فريداً لكل مشروع، يتم إنشاؤه عبر php artisan key:generate)
APP_DEBUG=false # تفعيل وضع تصحيح الأخطاء (يجب أن يكون false في الإنتاج لحماية البيانات)
LOG_LEVEL=debug # مستوى تسجيل الأخطاء في السجلات (Logs)
APP_URL=http://localhost:8006 # الرابط الأساسي للوصول للنظام المحلي

# ==========================================
# إعدادات قاعدة البيانات (Database)
# ==========================================
DB_CONNECTION=mysql # نوع قاعدة البيانات المستخدمة
DB_HOST=127.0.0.1 # خادم قاعدة البيانات (المحلي)
DB_PORT=3306 # منفذ الاتصال بقاعدة البيانات
DB_DATABASE=whatsapp_local # اسم قاعدة بيانات النظام المحلي
DB_USERNAME=root # اسم المستخدم لقاعدة البيانات
DB_PASSWORD= # كلمة مرور قاعدة البيانات المحلية (اتركها فارغة إذا لم تكن هناك كلمة مرور)

# ==========================================
# إعدادات الاتصال بالنظام المركزي
# ==========================================
CENTRAL_API_URL="https://rasayily.com/api" # رابط الـ API الخاص بالنظام المركزي للتواصل معه
CENTRAL_API_COMPANY_ID=1 # معرف الشركة التي يمثلها هذا النظام المحلي في النظام المركزي
CENTRAL_API_TOKEN="security_token" # توكن الأمان (Security Token) الخاص بالشركة للمصادقة مع النظام المركزي
CENTRAL_API_TIMEOUT=60 # أقصى مدة بالثواني للانتظار قبل اعتبار الاتصال بالنظام المركزي فاشلاً
CENTRAL_API_RETRY_ATTEMPTS=3 # عدد محاولات إعادة الاتصال بالنظام المركزي في حال الفشل
CENTRAL_API_RETRY_DELAY=5 # المدة بالثواني بين كل محاولة اتصال وأخرى

# ==========================================
# إعدادات الملفات (تخزين الفواتير والملفات المرسلة)
# ==========================================
FILES_STORAGE_PATH="invoices" # المجلد الذي يتم فيه تخزين الملفات الواردة/المرسلة (يتم حفظه داخل storage)
FILES_MAX_SIZE_MB=20 # أقصى حجم مسموح به للملفات (بالميجابايت)
FILE_ALLOWED_TYPES="pdf,jpg,jpeg,png,gif,bmp,tif,tiff,doc,docx,xlsx,xls,csv,txt" # أنواع الملفات المسموح التعامل معها (ملاحظة: اسم المتغيّر هنا صحيح والمستخدم فعلياً من الكود؛ FILES_ALLOWED_TYPES بالجمع كان اسماً خاطئاً في نسخة سابقة من هذا الملف ولم يُقرأ فعلياً)
FILES_AUTO_DELETE_DAYS=30 # عدد الأيام التي بعدها يتم حذف الملفات القديمة تلقائياً لتوفير المساحة

# ==========================================
# إعدادات إعادة إرسال الرسائل الفاشلة
# ==========================================
MAX_RETRY_ATTEMPTS=5 # الحد الأقصى لعدد محاولات إعادة إرسال الرسالة في حال فشل الإرسال
RETRY_DELAY_MINUTES=5 # الوقت بالدقائق للانتظار بين محاولات إعادة الإرسال

# ==========================================
# إعدادات المراقبة التلقائية للمجلدات (Folder Monitoring)
# ==========================================
MONITOR_FOLDER_PATH="C:/PrintMonitor" # مسار المجلد الذي يتم مراقبته لإرسال أي ملفات توضع فيه تلقائياً
MONITOR_INTERVAL_SECONDS=10 # عدد الثواني التي تفصل بين كل عملية فحص للمجلد
MONITOR_MESSAGE_TEXT="مرفق لكم المستند المطلوب" # النص الافتراضي المرافق للملفات المرسلة تلقائياً (اتركه فارغاً "" للإرسال بدون نص)

# ==========================================
# إعدادات استخراج رقم الجوال من محتوى الملفات (PDF/DOCX)
# ==========================================
PHONE_EXTRACTION_LABELS="رقم الجوال,الجوال,جوال,phone,mobile" # كلمات دلالية توحي بأن الرقم الذي يليها هو رقم العميل
PHONE_EXTRACTION_EXCLUDE_CONTEXT="المحل,محلنا,الشركة,شركتنا,مكتبنا,الفرع,فرعنا,store,shop,company,branch" # كلمات تشير إلى أرقام تخص المنشأة، فيتم استبعادها
PHONE_EXTRACTION_EXCLUDE_WINDOW_CHARS=40 # نطاق البحث (عدد الأحرف) قبل رقم الجوال للبحث عن كلمات الاستبعاد المذكورة أعلاه
FILE_NUMBER_LABELS="رقم الملف,الملف رقم,ملف رقم,file no,file number" # كلمات دلالية لاستخراج "رقم الملف"
PHONE_MATCH_MODE=exact # آلية البحث عن الكلمات (partial = تطابق جزئي، exact = الكلمة كاملة فقط)
ENABLE_UNLABELED_PHONE_FALLBACK=true # تفعيل خيار "آخر المطاف" وهو سحب أول رقم هاتف يبدو سعودياً من الملف إن لم توجد الكلمات الدلالية
PHONE_REVIEW_REQUIRED_SOURCES="unlabeled_fallback,corrupted_fallback,env_fallback" # قائمة بمصادر الأرقام التي تحتاج المراجعة اليدوية بدلاً من الإرسال الفوري (حماية من الأخطاء)

# ==========================================
# قراءة النصوص من الصور (OCR) عبر Tesseract — احتياطي عند تعذّر قراءة نص PDF/DOCX عادياً (اختياري)
# ==========================================
TESSERACT_BIN_PATH="C:/Program Files/Tesseract-OCR/tesseract.exe" # مسار برنامج Tesseract OCR بعد تثبيته (راجع صفحة /docs للتفاصيل)
GHOSTSCRIPT_BIN_PATH="C:/Program Files/gs/gs10.07.1/bin/gswin64c.exe" # مسار Ghostscript بعد تثبيته — يُستخدم لتحويل صفحة PDF الأولى لصورة كاحتياطي OCR أخير عند تلف طبقة النص (راجع صفحة /docs)

# ==========================================
# إعدادات النظام الداخلية
# ==========================================
SESSION_DRIVER=database # طريقة حفظ الجلسات (Sessions)، الافتراضي قاعدة البيانات
QUEUE_CONNECTION=database # طريقة معالجة المهام الخلفية (Queues)
DB_QUEUE_RETRY_AFTER=220 # مهلة إعادة المحاولة للمهام في قاعدة البيانات لمنع التكرار (بالثواني)
CACHE_STORE=database # محرك التخزين المؤقت (Cache)
APP_LOCALE=ar # لغة واجهة النظام الافتراضية (العربية)
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US

# ==========================================
# إعدادات الأمان والتشفير (للنظام المحلي)
# ==========================================
API_ENCRYPTION_KEY="" # مفتاح التشفير الخاص بالتواصل (اختياري)
API_VERIFY_SSL=false # التحقق من شهادة الـ SSL للاتصالات الخارجية (اجعلها false في بيئة التطوير)
API_USER_AGENT="WhatsApp-Local-System/1.0" # اسم المتصفح الافتراضي للطلبات الصادرة

# ==========================================
# بيانات تعريف نقطة البيع أو الجهاز
# ==========================================
DEVICE_NAME="Office_PC_01" # اسم الجهاز لتحديد مصدر الطلبات
LOCATION="Riyadh" # الموقع أو الفرع الخاص بالجهاز
PLAN_TYPE="Premium" # نوع باقة الاشتراك

# ==========================================
# نظام الطباعة الذكية (Smart Printing) وتنبيهاتها
# ==========================================
PRINTING_ENABLED=false # تفعيل ميزة استلام أوامر طباعة ملفات من الواتساب وطباعتها على طابعات الويندوز
SUMATRA_PDF_PATH="C:/SumatraPDF/SumatraPDF.exe" # مسار برنامج SumatraPDF المستخدم لطباعة الملفات بصمت
PRINT_TIMEOUT_SECONDS=180 # أقصى مدة بالثواني للانتظار حتى تنتهي الطباعة
PRINTER_ALERT_PHONE="" # رقم الجوال الذي تصله رسالة تنبيه فنية تفصيلية في حال فشل الطباعة نهائياً
PRINTING_REPLY_STATUS_TO_SENDER=true # إرسال رسالة رد تلقائي للعميل بنجاح أو فشل طباعة ملفه
PRINTING_REPLY_ACK_ON_RECEIPT=true # إرسال رسالة طمأنة فورية "تم استلام ملفك وجاري طباعته" بمجرد وصول الملف
PRINTING_NOTIFY_OWNER_ON_JOB_FAILURE=true # تفعيل تنبيه الفني (صاحب المنشأة) عند الفشل النهائي للطباعة عبر الرقم أعلاه
PRINTABLE_EXTENSIONS="pdf,jpg,jpeg,png,gif,bmp,tif,tiff,doc,docx,xls,xlsx,ppt,pptx" # امتدادات الملفات القابلة للطباعة الآلية (PDF والصور تُطبع مباشرة؛ Word/Excel/PowerPoint تُحوَّل تلقائياً إلى PDF عبر LibreOffice أولاً)
PRINT_IMAGE_PAGE_SIZE=a4 # مقاس الصفحة (a4 أو letter) التي تُوضع بداخلها الصور قبل الطباعة — يجب أن يطابق مقاس الورق الفعلي المُحمَّل في الطابعة، وإلا قد تظهر رسالة "الورق غير موجود" رغم وجود ورق فعلياً
PRINT_IMAGE_DPI=200 # الدقة (DPI) المفروضة على الصور قبل طباعتها (صور واتساب تصل بلا بيانات دقة أصلاً)؛ 200 قيمة متوازنة ولا حاجة لتغييرها عادة
LIBREOFFICE_PATH="C:/Program Files/LibreOffice/program/soffice.exe" # مسار LibreOffice المستخدم لتحويل ملفات Word/Excel/PowerPoint إلى PDF بصمت قبل الطباعة (يجب تثبيته أولاً)
OFFICE_CONVERSION_TIMEOUT_SECONDS=120 # أقصى مدة بالثواني لانتظار تحويل ملف أوفيس إلى PDF قبل اعتباره فشل












