# إعدادات الاتصال بالنظام المركزي
CENTRAL_API_URL="https://rasayily.com/api" # عنوان النظام المركزي على نفس الجهاز
CENTRAL_API_COMPANY_ID=1 # معرف الشركة التي يمثلها هذا النظام المحلي في النظام المركزي
CENTRAL_API_TOKEN="security_token" # توكن الأمان الخاص بهذه الشركة في النظام المركزي
CENTRAL_API_TIMEOUT=60
CENTRAL_API_RETRY_ATTEMPTS=3
CENTRAL_API_RETRY_DELAY=5




# إعدادات الملفات
FILES_STORAGE_PATH="invoices"
FILES_MAX_SIZE_MB=20
FILES_ALLOWED_TYPES="pdf,jpg,jpeg,png,doc,docx,xlsx,xls,csv,txt"
FILES_AUTO_DELETE_DAYS=30

# إعدادات إعادة الإرسال
MAX_RETRY_ATTEMPTS=5
RETRY_DELAY_MINUTES=5

# إعدادات المراقبة
MONITOR_FOLDER_PATH="C:/PrintMonitor"
MONITOR_INTERVAL_SECONDS=10
MONITOR_MESSAGE_TEXT="مرفق لكم المستند المطلوب" # النص الافتراضي المرسل مع الملفات المطبوعة. يمكنك تغييره هنا، أو كتابة "" (فارغ) للإرسال بدون نص مرافق.

SESSION_DRIVER=database
QUEUE_CONNECTION=database
CACHE_STORE=database

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=en_US





# إعدادات الأمان (للنظام المحلي)
API_ENCRYPTION_KEY="" # قم بتوليد مفتاح تشفير قوي باستخدام: php -r "echo bin2hex(random_bytes(32));"
API_VERIFY_SSL=false # اجعلها false للاختبار المحلي إذا لم تستخدم SSL
